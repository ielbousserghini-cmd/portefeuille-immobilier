# Copie ce fichier en ".env" pour le développement local (jamais commité).
# En production (Render), ces mêmes variables se règlent dans l'onglet
# "Environment" du service, pas dans un fichier.

# Chaîne de connexion PostgreSQL (ex. fournie par neon.tech)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Longue chaîne aléatoire secrète, utilisée pour signer les sessions.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi

# Identifiants du tout premier compte admin, créés automatiquement au premier
# démarrage si la table des utilisateurs est vide. Peuvent être retirés après.
ADMIN_NAME=Ismail
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-aussi

NODE_ENV=development

# Module "Suivi chantiers" : stockage des photos/documents sur Cloudinary
# (voir README.md, section "Module Suivi chantiers", pour la marche à suivre).
# Optionnel pour développer le reste de l'app ; nécessaire seulement pour
# tester l'envoi de photos/documents en local.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
